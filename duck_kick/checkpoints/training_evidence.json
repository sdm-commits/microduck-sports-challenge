  "kick_refinement_2026_09_05": {
    "why": "the on-target reward is a cliff: every in-zone shot paid the same, so nothing reduced lateral spread (90th pct 0.115 m vs zone half-width 0.125 m)",
    "change": "reward.aim_precision = 8.0, a once-per-episode crossing bonus 8*exp(-((crossing_y-target_y)/zone_half_width)^2); always non-negative so it cannot reward avoiding the goal line",
