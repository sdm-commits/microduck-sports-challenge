  "discarded_sharpened_aim_kernel": {
    "hypothesis": "the aim-precision bonus saturates: with kernel width = zone half-width (0.125 m) it already pays 82% of max at the measured 5.5 cm mean error, so it stops pulling. Narrowing the kernel to 0.05 m more than doubles the gradient at that error.",
    "run": "20 M steps, warm start from the shipped checkpoint, reward.aim_precision_width = 0.05, seed 91",
    "what_happened": "it did exactly what it was designed to do and still lost. Systematic bias with randomization off fell from 5.45 cm to 3.62 cm, but under domain randomization the policy got worse: 808/900 vs 848/900 on target and 8 falls vs 3.",
    "ab_test_900_shots_seeds_5000": {
      "sharpened": {
        "on_target": 808,
        "shots": 900,
        "falls": 8
      },
      "shipped": {
        "on_target": 848,
        "shots": 900,
        "falls": 3
      },
      "difference_pp": -4.44,
      "ci95_pp": [
        -6.94,
        -1.95
      ],
      "verdict": "discarded, shipped checkpoint kept"
    },
    "reading": "a sharply peaked reward buys nominal precision at the cost of robustness; the wider kernel leaves the policy tolerant of the mass/friction/gain draws that decide real shots"
  }
